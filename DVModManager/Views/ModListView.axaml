<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DVModManager.Views"
             xmlns:vm="using:DVModManager.ViewModels"
             xmlns:conv="using:DVModManager.Converters"
             x:Class="DVModManager.Views.ModListView"
             x:Name="Root">

    <Border Background="#181825"
            BorderBrush="#313244"
            BorderThickness="1"
            Margin="4">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Header row with title + Add Group button -->
            <Border Grid.Row="0"
                    Background="#1e1e2e"
                    Padding="12,8"
                    x:DataType="vm:MainWindowViewModel">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding #Root.Header}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#cdd6f4"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding AddGroupCommand}"
                            Content="{conv:Localize button.add_group}"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#89b4fa"
                            FontSize="12"
                            Padding="6,2"
                            ToolTip.Tip="{conv:Localize button.add_group}"
                            Cursor="Hand"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Search box -->
            <TextBox Grid.Row="1"
                     Text="{Binding #Root.Filter, Mode=TwoWay}"
                     PlaceholderText="{conv:Localize filter.search_mods}"
                     Background="#1e1e2e"
                     BorderBrush="#45475a"
                     BorderThickness="0,1,0,1"
                     Foreground="#cdd6f4"
                     Padding="10,6"
                     Margin="0" />

            <!-- Mod list — mixed ModGroupHeaderViewModel | ModItemViewModel -->
            <ListBox x:Name="ModListBox"
                     Grid.Row="2"
                     ItemsSource="{Binding #Root.Mods}"
                     SelectedItem="{Binding #Root.SelectedMod, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="4"
                     DragDrop.AllowDrop="True">
                <ListBox.DataTemplates>

                    <!-- Group header -->
                    <DataTemplate x:DataType="vm:ModGroupHeaderViewModel">
                        <Border Background="#252540"
                                CornerRadius="4"
                                Margin="0,4,0,1"
                                Padding="6,4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <!-- Collapse arrow -->
                                <Button Grid.Column="0"
                                        Command="{Binding ToggleCollapseCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#89b4fa"
                                        FontSize="11"
                                        Padding="2,0"
                                        Width="20"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                    <Panel>
                                        <TextBlock Text="▼" IsVisible="{Binding !IsCollapsed}" />
                                        <TextBlock Text="▶" IsVisible="{Binding IsCollapsed}" />
                                    </Panel>
                                </Button>

                                <!-- Name — TextBlock or inline editor -->
                                <Panel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               Foreground="#cdd6f4"
                                               FontSize="12"
                                               IsVisible="{Binding !IsRenaming}"
                                               VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal"
                                                IsVisible="{Binding IsRenaming}"
                                                Spacing="4">
                                        <TextBox Text="{Binding EditName, Mode=TwoWay}"
                                                 Foreground="#cdd6f4"
                                                 Background="#1e1e2e"
                                                 BorderBrush="#45475a"
                                                 Padding="4,2"
                                                 FontSize="12"
                                                 MinWidth="120" />
                                        <Button Command="{Binding ConfirmRenameCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#a6e3a1"
                                                FontSize="12"
                                                Padding="2">✔</Button>
                                        <Button Command="{Binding CancelRenameCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#f38ba8"
                                                FontSize="12"
                                                Padding="2">✖</Button>
                                    </StackPanel>
                                </Panel>

                                <!-- Mod count -->
                                <TextBlock Grid.Column="2"
                                           Foreground="#6c7086"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="6,0"
                                           Text="{Binding ModCount, StringFormat={}{0} mod(s)}" />

                                <!-- Rename + Delete buttons -->
                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            Spacing="2"
                                            IsVisible="{Binding !IsRenaming}">
                                    <Button Command="{Binding BeginRenameCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#89b4fa"
                                            FontSize="11"
                                            Padding="3,1"
                                            ToolTip.Tip="{conv:Localize button.rename_group}">✏</Button>
                                    <Button Command="{Binding DeleteGroupCommand}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="#f38ba8"
                                            FontSize="11"
                                            Padding="3,1"
                                            ToolTip.Tip="{conv:Localize button.delete_group}">🗑</Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <!-- Regular mod item -->
                    <DataTemplate x:DataType="vm:ModItemViewModel">
                        <Border Padding="8,6"
                                CornerRadius="4"
                                Margin="0,2">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                                <!-- Group indent indicator -->
                                <Border Grid.Column="0"
                                        Width="3"
                                        CornerRadius="2"
                                        Margin="0,0,6,0"
                                        Background="#89b4fa"
                                        IsVisible="{Binding IsGrouped}" />

                                <!-- Status dot -->
                                <Ellipse Grid.Column="1"
                                         Width="8" Height="8"
                                         Fill="{Binding StatusBrush}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />

                                <!-- Mod info -->
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="Medium"
                                               Foreground="#cdd6f4"
                                               FontSize="13" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Author}"
                                                   Foreground="#6c7086"
                                                   FontSize="11" />
                                        <TextBlock Text="•"
                                                   Foreground="#45475a"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding Version}"
                                                   Foreground="#45475a"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Update badge -->
                                <Border Grid.Column="3"
                                        Background="#f39c12"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasUpdate}">
                                    <TextBlock Text="{conv:Localize badge.update}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#1e1e2e" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>

                </ListBox.DataTemplates>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
