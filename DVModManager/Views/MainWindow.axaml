<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DVModManager.ViewModels"
        xmlns:views="using:DVModManager.Views"
        xmlns:conv="using:DVModManager.Converters"
        x:Class="DVModManager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#11111b"
        DragDrop.AllowDrop="True"
        DragDrop.DragEnter="OnDragEnter"
        DragDrop.DragLeave="OnDragLeave"
        DragDrop.DragOver="OnDragOver"
        DragDrop.Drop="OnDrop">

    <Window.Resources>
        <conv:InverseBoolConverter x:Key="InvBool" />
        <conv:NullToBoolConverter x:Key="NullToBool" />
        <conv:ModStateToBrushConverter x:Key="StateToBrush" />
        <conv:StringKeyConverter x:Key="LocalizeConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════
             TOOLBAR
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#1e1e2e"
                Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Left: Profile selector + actions -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6">

                    <TextBlock Text="{conv:Localize toolbar.profile.label}"
                               VerticalAlignment="Center"
                               Foreground="#cdd6f4"
                               FontSize="13" />

                    <ComboBox ItemsSource="{Binding ProfileNames}"
                              Text="{Binding SelectedProfileName, Mode=TwoWay}"
                              IsEditable="True"
                              MinWidth="160"
                              Background="#313244"
                              BorderBrush="#45475a" />

                    <Button Content="{conv:Localize toolbar.save_profile}"
                            Command="{Binding SaveCurrentProfileCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.save_profile.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.manage_profiles}"
                            Command="{Binding OpenProfilesCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.manage_profiles.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.start_game}"
                            Command="{Binding StartGameCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.start_game.tooltip}"
                            Background="#a6e3a1"
                            Foreground="#1e1e2e"
                            Padding="10,4" />
                </StackPanel>

                <!-- Center: spacer -->
                <Panel Grid.Column="1" />

                <!-- Right: global actions -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6">

                    <Button Content="{conv:Localize toolbar.refresh}"
                            Command="{Binding RefreshModsCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.refresh.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.unload_all}"
                            Command="{Binding DeactivateAllModsCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.unload_all.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.check_updates}"
                            Command="{Binding CheckUpdatesCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.check_updates.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.update_all}"
                            Command="{Binding UpdateAllModsCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.update_all.tooltip}"
                            Background="#45475a"
                            Foreground="#cdd6f4"
                            Padding="10,4" />

                    <Button Content="{conv:Localize toolbar.settings}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="{conv:Localize toolbar.settings.tooltip}"
                            Background="#313244"
                            Foreground="#cdd6f4"
                            FontSize="15"
                            Padding="10,4" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT: Available | Arrows | Active | Detail
             ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto,300">

            <!-- Available Mods -->
            <views:ModListView Grid.Column="0"
                               Header="{Binding PanelAvailableHeader}"
                               Mods="{Binding FilteredAvailableMods}"
                               Filter="{Binding AvailableFilter, Mode=TwoWay}"
                               SelectedMod="{Binding SelectedMod, Mode=TwoWay}"
                               Panel="available" />

            <!-- Activate / Deactivate buttons -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Margin="4,0">

                <Button Content="▶"
                        Command="{Binding ActivateSelectedModCommand}"
                        ToolTip.Tip="{conv:Localize activate.button.tooltip}"
                        Width="36" Height="36"
                        Background="#89b4fa"
                        Foreground="#1e1e2e"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{Binding IsGameRunning, Converter={StaticResource InvBool}}" />

                <Button Content="◀"
                        Command="{Binding DeactivateSelectedModCommand}"
                        ToolTip.Tip="{conv:Localize deactivate.button.tooltip}"
                        Width="36" Height="36"
                        Background="#f38ba8"
                        Foreground="#1e1e2e"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{Binding IsGameRunning, Converter={StaticResource InvBool}}" />

                <Button Content="⊕"
                        Command="{Binding InstallModFromFileCommand}"
                        ToolTip.Tip="{conv:Localize install.button.tooltip}"
                        Width="36" Height="36"
                        Background="#a6e3a1"
                        Foreground="#1e1e2e"
                        FontSize="16"
                        HorizontalContentAlignment="Center"
                        IsEnabled="{Binding IsGameRunning, Converter={StaticResource InvBool}}" />
            </StackPanel>

            <!-- Active Mods -->
            <views:ModListView Grid.Column="2"
                               Header="{Binding PanelActiveHeader}"
                               Mods="{Binding FilteredActiveMods}"
                               Filter="{Binding ActiveFilter, Mode=TwoWay}"
                               SelectedMod="{Binding SelectedMod, Mode=TwoWay}"
                               Panel="active"
                               ShowCompanionButton="True" />

            <!-- Splitter -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          Background="#313244"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Detail panel -->
            <views:ModDetailPanel Grid.Column="4" />
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             STATUS BAR
             ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#1e1e2e"
                Padding="10,5"
                BorderThickness="0,1,0,0"
                BorderBrush="#313244">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Game status indicator -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6">
                    <Ellipse Width="10" Height="10" Fill="#a6e3a1"
                             IsVisible="{Binding IsGameRunning}" />
                    <Ellipse Width="10" Height="10" Fill="#6c7086"
                             IsVisible="{Binding IsGameRunning, Converter={StaticResource InvBool}}" />
                    <TextBlock Text="{conv:Localize statusbar.game_running}"
                               IsVisible="{Binding IsGameRunning}"
                               Foreground="#a6e3a1"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{conv:Localize statusbar.game_not_running}"
                               IsVisible="{Binding IsGameRunning, Converter={StaticResource InvBool}}"
                               Foreground="#6c7086"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Status message -->
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Foreground="#a6adc8"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

                <!-- Busy indicator -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding IsBusy}">
                    <TextBlock Text="{Binding BusyMessage}"
                               Foreground="#89b4fa"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
