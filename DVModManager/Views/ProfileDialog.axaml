<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DVModManager.ViewModels"
        xmlns:models="using:DVModManager.Models"
        xmlns:conv="using:DVModManager.Converters"
        x:Class="DVModManager.Views.ProfileDialog"
        x:DataType="vm:ProfileViewModel"
        Title="{conv:Localize profile.dialog_title}"
        Width="500" Height="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e2e">

    <Window.Resources>
        <conv:NullToBoolConverter x:Key="NullToBool" />
    </Window.Resources>

    <Grid RowDefinitions="*,Auto" Margin="16">

        <!-- Content -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">

            <!-- Profile list -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,12,0">
                <TextBlock Grid.Row="0"
                           Text="{conv:Localize profile.saved_profiles}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#cdd6f4"
                           Margin="0,0,0,8" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                         Background="#181825"
                         BorderBrush="#45475a"
                         BorderThickness="1"
                         CornerRadius="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ModProfile">
                            <Border Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Medium"
                                               Foreground="#cdd6f4"
                                               FontSize="13" />
                                    <TextBlock Text="{Binding LastModifiedAt}"
                                               Foreground="#6c7086"
                                               FontSize="11" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- New profile row (note: saving is done via toolbar in main window) -->
                <Border Grid.Row="2"
                        Background="#313244"
                        CornerRadius="4"
                        Padding="8,6"
                        Margin="0,8,0,0">
                    <TextBlock Text="{conv:Localize profile.help_text}"
                               Foreground="#6c7086"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <!-- Actions column -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Top"
                        Spacing="8"
                        Margin="0,30,0,0">

                <Button Content="{conv:Localize profile.button_apply}"
                        Command="{Binding ApplySelectedCommand}"
                        CommandParameter="{Binding $parent[Window]}"
                        IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBool}}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#89b4fa"
                        Foreground="#1e1e2e"
                        Padding="10,6" />

                <Button Content="{conv:Localize profile.button_export}"
                        Command="{Binding ExportSelectedCommand}"
                        IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBool}}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#313244"
                        Foreground="#cdd6f4"
                        Padding="10,6" />

                <Button Content="{conv:Localize profile.button_import}"
                        Command="{Binding ImportCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#313244"
                        Foreground="#cdd6f4"
                        Padding="10,6" />

                <Button Content="{conv:Localize profile.button_delete}"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding SelectedProfile, Converter={StaticResource NullToBool}}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Background="#f38ba8"
                        Foreground="#1e1e2e"
                        Padding="10,6" />            </StackPanel>
        </Grid>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="{conv:Localize button.close}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    Background="#313244"
                    Foreground="#cdd6f4"
                    Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
