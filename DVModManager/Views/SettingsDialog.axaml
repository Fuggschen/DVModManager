<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DVModManager.ViewModels"
        xmlns:conv="using:DVModManager.Converters"
        x:Class="DVModManager.Views.SettingsDialog"
        x:DataType="vm:SettingsViewModel"
        Title="{conv:Localize settings.title}"
        Width="600" Height="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1e1e2e">

    <Grid RowDefinitions="*,Auto" Margin="20">

        <!-- Settings content -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">

                <!-- ── Game Path ──────────────────────────────────── -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{conv:Localize settings.section.game_path}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#cdd6f4" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding GamePath, Mode=TwoWay}"
                                 PlaceholderText="{conv:Localize settings.game_path.placeholder}"
                                 Background="#313244"
                                 BorderBrush="#45475a"
                                 Foreground="#cdd6f4"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="{conv:Localize settings.game_path.browse}"
                                Command="{Binding BrowseGamePathCommand}"
                                Background="#45475a"
                                Foreground="#cdd6f4"
                                Padding="10,6"
                                Margin="0,0,4,0" />
                        <Button Grid.Column="2"
                                Content="{conv:Localize settings.game_path.auto}"
                                Command="{Binding DetectGamePathCommand}"
                                ToolTip.Tip="{conv:Localize settings.game_path.auto.tooltip}"
                                Background="#89b4fa"
                                Foreground="#1e1e2e"
                                Padding="10,6" />
                    </Grid>
                </StackPanel>

                <!-- ── Storage Path ───────────────────────────────── -->
                <StackPanel Spacing="6">
                    <TextBlock Text="{conv:Localize settings.section.storage}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#cdd6f4" />
                    <TextBlock Text="{conv:Localize settings.storage.description}"
                               Foreground="#6c7086"
                               FontSize="11" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding StoragePath, Mode=TwoWay}"
                                 Background="#313244"
                                 BorderBrush="#45475a"
                                 Foreground="#cdd6f4"
                                 Margin="0,0,6,0" />
                        <Button Grid.Column="1"
                                Content="{conv:Localize settings.storage.browse}"
                                Command="{Binding BrowseStoragePathCommand}"
                                Background="#45475a"
                                Foreground="#cdd6f4"
                                Padding="10,6" />
                    </Grid>
                </StackPanel>

                <!-- ── Misc settings ──────────────────────────────── -->
                <StackPanel Spacing="10">
                    <TextBlock Text="{conv:Localize settings.section.general}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#cdd6f4" />

                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="{conv:Localize settings.auto_check_updates}"
                                   Foreground="#cdd6f4"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Row="0" Grid.Column="1"
                                  IsChecked="{Binding AutoCheckUpdates, Mode=TwoWay}"
                                  HorizontalAlignment="Right" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{conv:Localize settings.enable_version_archiving}"
                                   Foreground="#cdd6f4"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <CheckBox Grid.Row="1" Grid.Column="1"
                                  IsChecked="{Binding EnableVersionArchiving, Mode=TwoWay}"
                                  HorizontalAlignment="Right"
                                  Margin="0,8,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="{conv:Localize settings.max_cache_size}"
                                   Foreground="#cdd6f4"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MaxCacheGb, Mode=TwoWay}"
                                       Minimum="1" Maximum="100"
                                       Increment="1"
                                       Width="100"
                                       Background="#313244"
                                       BorderBrush="#45475a"
                                       Foreground="#cdd6f4"
                                       HorizontalAlignment="Right"
                                       Margin="0,8,0,0" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="{conv:Localize settings.language}"
                                   Foreground="#cdd6f4"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <ComboBox Grid.Row="3" Grid.Column="1"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding Language, Mode=TwoWay}"
                                  Background="#313244"
                                  BorderBrush="#45475a"
                                  Foreground="#cdd6f4"
                                  Width="100"
                                  HorizontalAlignment="Right"
                                  Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="{conv:Localize settings.button.cancel}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    Background="#313244"
                    Foreground="#cdd6f4"
                    Padding="20,8" />
            <Button Content="{conv:Localize settings.button.save}"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding $parent[Window]}"
                    Background="#a6e3a1"
                    Foreground="#1e1e2e"
                    Padding="20,8" />
        </StackPanel>
    </Grid>
</Window>
